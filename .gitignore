# Dataset stays out of version control: it is large and trivial to
# re-download with src/01_download_data.py.
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep

# Checkpoints are large binaries, regenerate them with train_all.py
models/*
!models/.gitkeep

# NOTE: figures/ and metrics_summary.csv are committed ON PURPOSE.
# They are the evidence of this comparative study (accuracy charts,
# confusion matrices, training curves) and belong in the repo.

# The live demo writes ad-hoc result screenshots here at runtime
output/*
!output/.gitkeep

# Kaggle credentials should never end up in a public repo
kaggle.json

# standard Python housekeeping
__pycache__/
*.pyc
.ipynb_checkpoints/
.pytest_cache/
.DS_Store
*.egg-info/
venv/
.venv/

