# I keep the raw dataset and generated artifacts out of version control,
# they're either too large or too easy to regenerate to belong in git.
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep

models/*
!models/.gitkeep

figures/*
!figures/.gitkeep

output/*
!output/.gitkeep

metrics_summary.csv

# Kaggle credentials should never end up in a public repo
kaggle.json

# standard Python housekeeping
__pycache__/
*.pyc
.ipynb_checkpoints/
.DS_Store
*.egg-info/
venv/
.venv/
